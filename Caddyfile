# Serves the prerendered static site in ./build.
# Deploy: `npm run build`, then reload Caddy pointing at this file.
#
#   caddy run --config ./Caddyfile
#
# Swap `springfieldyonga.work` for `:8080` to serve locally over HTTP without
# automatic HTTPS.

springfieldyonga.work, www.springfieldyonga.work {
	root * /srv/springfieldyonga/build
	encode gzip zstd

	# SvelteKit's static adapter emits pretty-URL directories (index.html per
	# route) plus a 404.html fallback.
	try_files {path} {path}/ {path}/index.html
	file_server

	handle_errors {
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}

	# Fingerprinted assets are immutable; hash changes on rebuild.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header /rss.xml Content-Type "application/rss+xml; charset=utf-8"

	log {
		output stdout
	}
}
