# Container serving config — used by the Dockerfile's serve stage.
# Listens on plain HTTP :80; TLS + routing are handled upstream by Dokploy's
# Traefik reverse proxy, so there is no domain block and no automatic HTTPS.
#
# (The root-level ./Caddyfile is the bare-metal variant with the real domain.)

:80 {
	root * /srv
	encode gzip zstd

	# SvelteKit's static adapter emits pretty-URL directories (index.html per
	# route) plus a 404.html fallback.
	try_files {path} {path}/ {path}/index.html
	file_server

	handle_errors {
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}

	# Fingerprinted assets are immutable; hash changes on rebuild.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header /rss.xml Content-Type "application/rss+xml; charset=utf-8"

	log {
		output stdout
	}
}
